# Variáveis de ambiente para o projeto Next.js com Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
#sua chave pública do Supabase, que pode ser encontrada no painel do Supabase em Configurações > API > Chave Anônima
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica

# Variáveis de ambiente para o banco de dados PostgreSQL
DATABASE_URL="sua-string-de-conexao-do-postgres"
# Variável de ambiente para conexão direta com o banco de dados PostgreSQL
DIRECT_URL="sua-string-de-conexao-direta-do-postgres"